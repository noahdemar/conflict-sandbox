{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noahdemar.github.io/conflict-sandbox/schema/scenario.schema.json",
  "title": "OpenBrief scenario",
  "description": "A map scenario for OpenBrief. Either a bare Scenario object, or the exported file wrapper {format, version, duration, roster, scenario}. Times are timeline seconds; coordinates are [longitude, latitude] or {lat, lng}.",
  "oneOf": [
    {
      "$ref": "#/definitions/ScenarioFile"
    },
    {
      "$ref": "#/definitions/Scenario"
    }
  ],
  "definitions": {
    "Faction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "affiliation": {
          "$ref": "#/definitions/Affiliation",
          "description": "Symbol frame shape; inferred from faction order/name when unset"
        }
      },
      "required": [
        "id",
        "name",
        "color"
      ],
      "additionalProperties": false
    },
    "Affiliation": {
      "type": "string",
      "enum": [
        "friend",
        "hostile",
        "neutral",
        "unknown"
      ]
    },
    "Unit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "factionId": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/UnitType"
        },
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "arrowId": {
          "type": "string",
          "description": "Arrow id this unit advances along during playback"
        },
        "rosterId": {
          "type": "string",
          "description": "Roster entry this unit was placed from (enables custom 3D assets)"
        },
        "icon": {
          "type": "string",
          "description": "Icon from the shared library (see the catalog in llms.txt), e.g. \"tank\", \"archers\", \"carrier\". Unknown names fall back to a generic icon for the unit type and are reported when the scenario is imported."
        },
        "heading": {
          "type": "number",
          "description": "Facing direction in degrees when not following an arrow"
        },
        "rangeKm": {
          "type": "number",
          "description": "Weapon/sensor range ring in km; 0/undefined = none"
        },
        "appearAt": {
          "type": "number",
          "description": "Seconds on the timeline when the unit appears"
        },
        "destroyedAt": {
          "type": "number",
          "description": "Seconds on the timeline when the unit is destroyed (becomes a burning wreck)"
        },
        "sensorKm": {
          "type": "number",
          "description": "Observation/sensor range in km: draws a terrain-aware line-of-sight area"
        },
        "airDefenseKm": {
          "type": "number",
          "description": "Air-defense engagement range in km: draws an envelope that reacts to enemy aircraft"
        },
        "landAtEnd": {
          "type": "boolean",
          "description": "Aircraft sets down at the end of its route instead of loitering"
        },
        "leavesAt": {
          "type": "number",
          "description": "Seconds on the timeline when the unit leaves the scene (e.g. boards an aircraft)"
        },
        "altitudeKm": {
          "type": "number",
          "description": "Orbital/very-high altitude in km: rendered in 3D space above its ground track"
        },
        "orbitRole": {
          "type": "string",
          "enum": [
            "relay",
            "imaging"
          ],
          "description": "Orbital payload role: wide relay coverage or a narrow imaging footprint"
        },
        "captureAt": {
          "type": "number",
          "description": "Timeline time an imaging satellite captures its target"
        }
      },
      "required": [
        "id",
        "factionId",
        "type",
        "name",
        "lat",
        "lng",
        "appearAt"
      ],
      "additionalProperties": false
    },
    "UnitType": {
      "type": "string",
      "enum": [
        "infantry",
        "armor",
        "artillery",
        "air",
        "naval",
        "missile",
        "hq"
      ]
    },
    "Arrow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "factionId": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "[lng, lat] control points"
        },
        "name": {
          "type": "string"
        },
        "appearAt": {
          "type": "number"
        },
        "duration": {
          "type": "number",
          "description": "Seconds the arrow takes to fully draw"
        },
        "followRoads": {
          "type": "boolean",
          "description": "Snap ground units on this arrow to real roads (default true)"
        },
        "hideLine": {
          "type": "boolean",
          "description": "Movement path only: don't draw the arrow on the map"
        },
        "hideAt": {
          "type": "number",
          "description": "Timeline time after which the arrow is no longer drawn"
        },
        "times": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Absolute time (s) for each control point: move between them, holding when two are equal in place"
        },
        "route": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Cached road route [lng, lat] through the control points"
        },
        "routeKey": {
          "type": "string",
          "description": "Control-point signature the cached route was computed for"
        }
      },
      "required": [
        "id",
        "factionId",
        "points",
        "name",
        "appearAt",
        "duration"
      ],
      "additionalProperties": false
    },
    "Territory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "factionId": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "[lng, lat] ring"
        },
        "name": {
          "type": "string"
        },
        "appearAt": {
          "type": "number"
        },
        "duration": {
          "type": "number",
          "description": "Seconds the fill takes to fade in"
        },
        "label": {
          "type": "string",
          "description": "Large watermark text drawn across the territory (e.g. \"SDF\")"
        },
        "labelAt": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Watermark position [lng, lat]; defaults to the polygon centroid"
        },
        "labelRotate": {
          "type": "number",
          "description": "Watermark rotation in degrees"
        }
      },
      "required": [
        "id",
        "factionId",
        "points",
        "name",
        "appearAt",
        "duration"
      ],
      "additionalProperties": false
    },
    "MapLabel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "size": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "appearAt": {
          "type": "number"
        },
        "flag": {
          "type": "string",
          "description": "ISO 3166 country code: render a flag sticker instead of plain text"
        },
        "facility": {
          "$ref": "#/definitions/FacilityKind",
          "description": "Render as a facility marker (icon sticker + caption)"
        }
      },
      "required": [
        "id",
        "text",
        "lat",
        "lng",
        "size",
        "color",
        "appearAt"
      ],
      "additionalProperties": false
    },
    "FacilityKind": {
      "type": "string",
      "enum": [
        "oil",
        "gas",
        "refinery",
        "airbase",
        "port",
        "power",
        "base",
        "hq",
        "bridge",
        "hospital",
        "town"
      ],
      "description": "Facility kinds a map label can be shown as. Icons are 24x24 stroke SVG bodies."
    },
    "Strike": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "description": "Explosion visual scale multiplier"
        },
        "impactStyle": {
          "type": "string",
          "enum": [
            "blast",
            "fireball"
          ]
        },
        "appearAt": {
          "type": "number"
        },
        "fromUnitId": {
          "type": "string",
          "description": "Unit the missile launches from; ballistic arc is rendered in flight"
        },
        "launchAt": {
          "type": "number",
          "description": "Launch time (s); defaults to a flight time derived from weapon type and distance"
        },
        "targetStrikeId": {
          "type": "string",
          "description": "Target strike id for interceptor strikes"
        },
        "targetUnitId": {
          "type": "string",
          "description": "Unit being hit: impact follows that unit's position at detonation time"
        },
        "salvo": {
          "type": "number",
          "description": "Number of rounds in a salvo (gunship/artillery); impacts scatter around the aim point"
        },
        "spreadM": {
          "type": "number",
          "description": "Salvo scatter radius in meters (default 120)"
        }
      },
      "required": [
        "id",
        "lat",
        "lng",
        "name",
        "size",
        "appearAt"
      ],
      "additionalProperties": false
    },
    "Keyframe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "time": {
          "type": "number",
          "description": "Seconds on the timeline"
        },
        "lng": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        },
        "pitch": {
          "type": "number",
          "description": "Camera tilt in degrees (0 = top-down)"
        },
        "bearing": {
          "type": "number",
          "description": "Camera rotation in degrees"
        },
        "caption": {
          "type": "string",
          "description": "Slide-style caption shown while this keyframe is active"
        },
        "highlightUnitIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units emphasized on the map and in the caption while this keyframe is active"
        },
        "followUnitId": {
          "type": "string",
          "description": "Camera tracks this unit while the keyframe is active"
        },
        "followMode": {
          "type": "string",
          "enum": [
            "track",
            "chase"
          ],
          "description": "'track' keeps unit centered; 'chase' also turns camera to unit heading"
        },
        "orbitSpeed": {
          "type": "number",
          "description": "Camera orbit speed in deg/s while this keyframe is active"
        },
        "narrate": {
          "type": "boolean",
          "description": "Speak this caption aloud (default true); false shows it as text only"
        },
        "sensor": {
          "$ref": "#/definitions/SensorView",
          "description": "Sensor view applied while this keyframe is active"
        },
        "aerial": {
          "$ref": "#/definitions/AerialShot",
          "description": "While this keyframe is active, show the 3D aerial scene from this camera shot instead of the map"
        },
        "overlay": {
          "$ref": "#/definitions/ShotOverlay",
          "description": "On-screen graphic flashed up while this keyframe is active"
        },
        "overlayFactionIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Factions included when the order-of-battle overlay is active"
        },
        "media": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            },
            "anchor": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Place the image beside this map point instead of at the screen edge"
            },
            "anchorRadiusM": {
              "type": "number",
              "description": "Half-width of the site at the anchor in meters, so the image clears it"
            }
          },
          "required": [
            "src"
          ],
          "additionalProperties": false,
          "description": "Full-screen image card shown while this keyframe is active"
        }
      },
      "required": [
        "id",
        "time",
        "lng",
        "lat",
        "zoom",
        "pitch",
        "bearing",
        "caption"
      ],
      "additionalProperties": false
    },
    "SensorView": {
      "type": "string",
      "enum": [
        "normal",
        "nvg",
        "thermal"
      ]
    },
    "AerialShot": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "chase",
            "side",
            "flyby",
            "overview",
            "compare"
          ],
          "description": "chase: behind the target; side: beside it; flyby: fixed point it passes; overview: orbit above the fight; compare: the target and secondary aircraft side by side on turntables with a stats panel (pair it with a hold)"
        },
        "target": {
          "type": "string",
          "description": "Aircraft the camera follows or frames"
        },
        "secondary": {
          "type": "string",
          "description": "Second aircraft kept in frame (overview)"
        },
        "distanceM": {
          "type": "number",
          "description": "Camera distance in meters (defaults per mode)"
        },
        "orbitDegPerS": {
          "type": "number",
          "description": "Degrees per second the overview orbits"
        },
        "compare": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AerialCompareRow"
              }
            },
            "note": {
              "type": "string",
              "description": "Small print under the panel, e.g. that figures are approximate"
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": false,
          "description": "Stats panel for the compare shot: target on the left, secondary on the right"
        }
      },
      "required": [
        "mode",
        "target"
      ],
      "additionalProperties": false,
      "description": "Camera for a keyframe in the aerial scene."
    },
    "AerialCompareRow": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Text for [left, right]"
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Numbers for [left, right] to draw proportional bars (same unit on both sides)"
        }
      },
      "required": [
        "label",
        "values"
      ],
      "additionalProperties": false,
      "description": "One line of an aircraft comparison: a value for each aircraft and optional bar sizes."
    },
    "ShotOverlay": {
      "type": "string",
      "const": "orbat",
      "description": "On-screen graphics a keyframe can flash up over the map."
    },
    "StatusEffect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/StatusKind"
        },
        "unitId": {
          "type": "string"
        },
        "targetUnitId": {
          "type": "string",
          "description": "Other end of a datalink"
        },
        "start": {
          "type": "number",
          "description": "Seconds on the timeline when the effect starts"
        },
        "duration": {
          "type": "number",
          "description": "Seconds it lasts"
        },
        "radiusM": {
          "type": "number",
          "description": "Jamming radius in meters"
        },
        "label": {
          "type": "string",
          "description": "Custom badge text (defaults per kind)"
        }
      },
      "required": [
        "id",
        "kind",
        "unitId",
        "start",
        "duration"
      ],
      "additionalProperties": false,
      "description": "A timed status/activity shown on a unit (radio call, jamming, panic…)."
    },
    "StatusKind": {
      "type": "string",
      "enum": [
        "radio",
        "datalink",
        "jamming",
        "panic",
        "wounded",
        "noammo"
      ]
    },
    "Environment": {
      "type": "object",
      "properties": {
        "startHour": {
          "type": "number",
          "description": "Local hour (0-24) at timeline start"
        },
        "endHour": {
          "type": "number",
          "description": "Local hour at timeline end; may be less than start to cross midnight"
        },
        "date": {
          "type": "string",
          "description": "Calendar date at timeline start (YYYY-MM-DD) for sun position"
        },
        "utcOffset": {
          "type": "number",
          "description": "Local time zone offset from UTC in hours (e.g. 5 for Pakistan)"
        },
        "hourKeys": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Optional piecewise clock: [timeline seconds, local hours since start day] pairs (hours may exceed 24), e.g. to cut from night to the next morning. Overrides the linear start→end mapping."
        },
        "windDirDeg": {
          "type": "number",
          "description": "Direction the wind blows toward, compass degrees"
        },
        "windKph": {
          "type": "number"
        },
        "haze": {
          "type": "number",
          "description": "Dust/haze density 0..1"
        },
        "cloudCover": {
          "type": "number",
          "description": "Cloud cover 0..1: flattens and greys the light, mutes golden hour"
        },
        "precipitation": {
          "type": "string",
          "enum": [
            "none",
            "rain",
            "snow",
            "dust"
          ],
          "description": "Falling weather drawn over the scene"
        },
        "precipIntensity": {
          "type": "number",
          "description": "Precipitation strength 0..1 (default 0.5)"
        }
      },
      "required": [
        "startHour",
        "endHour",
        "windDirDeg",
        "windKph",
        "haze"
      ],
      "additionalProperties": false,
      "description": "Lighting and weather over the scenario timeline."
    },
    "AerialScene": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[lng, lat] of the local origin"
        },
        "style": {
          "$ref": "#/definitions/AerialStyle",
          "description": "Default look; viewers can switch"
        },
        "aircraft": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AerialAircraft"
          }
        },
        "weapons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AerialWeapon"
          }
        },
        "holds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "number"
              },
              "seconds": {
                "type": "number"
              }
            },
            "required": [
              "at",
              "seconds"
            ],
            "additionalProperties": false
          },
          "description": "Explanatory freezes: at timeline second `at`, aircraft hold for `seconds`"
        },
        "terrain": {
          "type": "string",
          "enum": [
            "real",
            "jungle",
            "desert",
            "sea",
            "plain"
          ],
          "description": "Ground: \"real\" builds the actual terrain around `origin` from elevation data; the others are stylized textures on flat ground (default plain)."
        },
        "terrainTexture": {
          "type": "string",
          "enum": [
            "basemap",
            "satellite"
          ],
          "description": "Texture draped on real terrain: \"basemap\" is our map with every name, road, border and building removed; \"satellite\" is cloud-free Sentinel-2 imagery (shows the present-day landscape). Default basemap."
        },
        "terrainRadiusKm": {
          "type": "number",
          "description": "Half-width of the real-terrain square in km (default 30)"
        },
        "terrainExaggeration": {
          "type": "number",
          "description": "Vertical exaggeration for real terrain (default 1)"
        }
      },
      "required": [
        "origin",
        "aircraft"
      ],
      "additionalProperties": false,
      "description": "A 3D air-combat reconstruction, in a local frame anchored at `origin`. Aircraft times are flight seconds; `holds` pause the aircraft (not the camera) for explanation, so flight time falls behind timeline time."
    },
    "AerialStyle": {
      "type": "string",
      "enum": [
        "cinematic",
        "briefing"
      ],
      "description": "Visual treatment of the 3D aerial scene."
    },
    "AerialAircraft": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "factionId": {
          "type": "string"
        },
        "airframe": {
          "$ref": "#/definitions/Airframe"
        },
        "track": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "description": "Flight path as [flight seconds, meters east, meters north, meters altitude] relative to the scene origin. Points are smoothed; bank and pitch come from the curvature, so sample every second or two through maneuvers."
        },
        "destroyedAt": {
          "type": "number",
          "description": "Flight time the aircraft is shot down: it falls trailing smoke from here"
        }
      },
      "required": [
        "id",
        "name",
        "factionId",
        "airframe",
        "track"
      ],
      "additionalProperties": false,
      "description": "One aircraft in the aerial scene."
    },
    "Airframe": {
      "type": "string",
      "enum": [
        "f4",
        "mig17",
        "jet"
      ],
      "description": "Built-in procedural airframes (no model files)."
    },
    "AerialWeapon": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "guns",
            "missile"
          ]
        },
        "from": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "time": {
          "type": "number",
          "description": "Fire time (flight seconds)"
        },
        "duration": {
          "type": "number",
          "description": "Seconds the burst lasts, or the missile flies (default 1.2 guns, 3 missile)"
        },
        "hit": {
          "type": "boolean",
          "description": "Missile hits its target at the end of its flight (default true)"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "target",
        "time"
      ],
      "additionalProperties": false,
      "description": "Guns burst or missile shot between aircraft. Times are flight seconds."
    },
    "ArticleBlock": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "heading"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scene"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image"
            },
            "src": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "src"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "callout"
            },
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "wikiTitle": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            },
            "side": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            }
          },
          "required": [
            "kind",
            "title",
            "text"
          ],
          "additionalProperties": false
        }
      ],
      "description": "One block of the article presentation. A scene embeds the map and plays the timeline from keyframe `from` up to the keyframe that follows `to` (or the end), holding on its last frame."
    },
    "Scenario": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "factions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Faction"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Unit"
          }
        },
        "arrows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Arrow"
          }
        },
        "territories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Territory"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MapLabel"
          }
        },
        "strikes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Strike"
          }
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Keyframe"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StatusEffect"
          },
          "description": "Unit status effects; optional for older scenarios"
        },
        "environment": {
          "$ref": "#/definitions/Environment",
          "description": "Lighting & weather; optional (defaults to midday, calm, clear)"
        },
        "duration": {
          "type": "number",
          "description": "Timeline length in seconds (defaults to 60)"
        },
        "narrationPack": {
          "type": "string",
          "description": "Folder of pre-recorded caption narration (with manifest.json), relative to the site base"
        },
        "subtitle": {
          "type": "string",
          "description": "Standfirst under the article headline, e.g. \"Deir ez-Zor, Syria · 7–8 February 2018\""
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "References listed at the end of the article, e.g. \"US Department of Defense briefing, 13 February 2018\""
        },
        "era": {
          "type": "string",
          "enum": [
            "modern",
            "historical"
          ],
          "description": "Visual era. \"historical\" hides modern map features (roads, buildings, borders, place labels), uses an aged parchment palette, and drops modern interface elements; for events before the modern period."
        },
        "aerial": {
          "$ref": "#/definitions/AerialScene",
          "description": "3D air-combat scene shown by keyframes that set `aerial`"
        },
        "article": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArticleBlock"
          },
          "description": "Article presentation: prose with embedded map scenes. Generated from captions when absent"
        }
      },
      "required": [
        "name",
        "factions",
        "units",
        "arrows",
        "territories",
        "labels",
        "strikes",
        "keyframes"
      ],
      "additionalProperties": false
    },
    "RosterEntry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Also drives the unit silhouette, e.g. \"T-72 Tank\", \"AH-64 Apache\", \"MQ-9 Reaper\"."
        },
        "type": {
          "$ref": "#/definitions/UnitType"
        },
        "faction": {
          "type": "string"
        },
        "modelUrl": {
          "type": "string"
        },
        "modelYaw": {
          "type": "number"
        },
        "rangeKm": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string"
        },
        "wikiTitle": {
          "type": "string"
        }
      }
    },
    "ScenarioFile": {
      "type": "object",
      "required": [
        "format",
        "scenario"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "conflict-sandbox-scenario"
        },
        "version": {
          "type": "number"
        },
        "exportedAt": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "description": "Timeline length in seconds."
        },
        "roster": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RosterEntry"
          }
        },
        "scenario": {
          "$ref": "#/definitions/Scenario"
        }
      }
    }
  }
}
